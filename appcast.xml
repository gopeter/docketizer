        <item>
            <title>Version 1.1.1</title>
            <pubDate>Thu, 15 Oct 2026 12:18:15 +0000</pubDate>
            <sparkle:version>3</sparkle:version>
            <sparkle:shortVersionString>1.1.1</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description
            ><![CDATA[
                <h3>Fixes</h3>
                <ul>
                    <li>Installing updates works again. If you are on version 1.0, please install this version manually once.</li>
                    <li>"Settings" and "Check for Updates" in the right-click menu work right after launch.</li>
                    <li>The global shortcut works right after launch, without opening docketizer first.</li>
                    <li>docketizer now checks for updates automatically every hour.</li>
                </ul>
            ]]></description>
            <enclosure
                url="https://intern.evernow.dev/docketizer/releases/docketizer-1.1.1.zip"
