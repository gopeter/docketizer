"""An object with an ID."""
interface Node {
  """ID of the object."""
  id: ID!
}

type Notification {
  action: NotificationAction!
  count: Int!
  countArchived: Int!
  countIsNew: Int!
  createdAt: ISO8601DateTime!
  id: String!
  record: NotificationRecordUnion
  updatedAt: ISO8601DateTime!
  user: User!
}

enum NotificationAction {
  """Ticket was created"""
  TICKET_CREATED

  """Ticket was closed"""
  TICKET_CLOSED

  """Ticket was reopened"""
  TICKET_REOPENED

  """A User was mentioned in a ticket"""
  TICKET_MENTIONED

  """Ticket was assigned to a user"""
  TICKET_ASSIGNED

  """Ticket was unassigned from a user"""
  TICKET_UNASSIGNED

  """Ticket was planned"""
  TICKET_PLANNED

  """Ticket comment was added"""
  TICKET_COMMENT_ADDED

  """A user was mentioned in a ticket comment"""
  TICKET_COMMENT_MENTIONED

  """Quotation comment was added"""
  QUOTATION_COMMENT_ADDED

  """A user was mentioned in a quotation comment"""
  QUOTATION_COMMENT_MENTIONED

  """Order confirmation comment was added"""
  ORDER_CONFIRMATION_COMMENT_ADDED

  """A user was mentioned in a order confirmation comment"""
  ORDER_CONFIRMATION_COMMENT_MENTIONED

  """Delivery note comment was added"""
  DELIVERY_NOTE_COMMENT_ADDED

  """A user was mentioned in a delivery note comment"""
  DELIVERY_NOTE_COMMENT_MENTIONED

  """Invoice comment was added"""
  INVOICE_COMMENT_ADDED

  """A user was mentioned in an invoice comment"""
  INVOICE_COMMENT_MENTIONED
}

